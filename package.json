{
  "name": "classicmail",
  "private": true,
  "description": "A desktop client for Google Workspace and Gmail in the classic Outlook style",
  "author": "Kenny Green <info@duvz.com> (Duvz Software)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kenrunio/classicmail.git"
  },
  "version": "1.24.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "node scripts/dev.mjs",
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "preview:real": "node scripts/preview.mjs",
    "lint": "eslint . && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{js,ts,json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{js,ts,json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.14",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-font-family": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "marked": "^18.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "turndown": "^7.2.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
