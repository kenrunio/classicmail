{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClassicMail",
  "version": "1.24.2",
  "identifier": "com.ekgir.classicmail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mail - ClassicMail",
        "url": "index.html?window=main",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://cmattach.localhost cmattach: https: http:",
        "font-src": "'self' data: https: http:",
        "media-src": "'self' data: blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'self' http://cmattach.localhost cmattach:"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Duvz Software",
    "copyright": "© 2026 Duvz Software (Kenny Green). Apache License 2.0",
    "category": "Productivity",
    "shortDescription": "Mail, calendar and contacts for Google Workspace in the classic Outlook style",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
